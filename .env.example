# Copy to .env and fill in. Never commit the real .env file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=wisdomschool.uz,www.wisdomschool.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://wisdomschool.uz,https://www.wisdomschool.uz
DJANGO_SSL_REDIRECT=false

# Database: sqlite (default) or mysql
DB_ENGINE=sqlite
# DB_NAME=wisdoms1_site
# DB_USER=wisdoms1_site
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Admissions form e-mail notifications (optional)
